        {
          "section": "shell.navbar",
          "required": true,
          "repeatable": false
        },
        {
          "section": "hero.landing-hero",
          "required": true,
          "repeatable": false
        },
        {
          "section": "showcase.persona-tabs",
          "required": true,
          "repeatable": false
        },
        {
          "section": "features.feature-grid",
          "required": true,
          "repeatable": false
        },
        {
          "section": "support.faq",
          "required": true,
          "repeatable": false
        },
        {
          "section": "cta.download-icon",
          "required": true,
          "repeatable": false
