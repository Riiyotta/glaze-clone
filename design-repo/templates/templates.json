        {
          "section": "shell.footer",
          "required": true,
          "repeatable": false
        },
        {
          "section": "shell.youtube-overlay",
          "required": true,
          "repeatable": false
        }
      ],
      "constraints": {
        "requiredInitialTab": "personal",
        "navActiveLinkHref": "/"
