      "id": "template.landing",
      "version": "1.0.0",
      "name": "Landing page",
      "routes": [
        "/"
      ],
      "routeKind": "static",
      "evidence": "measured",
      "description": "Home page. Hero, persona showcase, feature grid, FAQ, download CTA, footer, video overlay.",
