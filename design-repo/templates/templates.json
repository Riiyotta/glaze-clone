        {
          "id": "main",
          "kind": "main",
          "classContract": "flex column, min-height 100dvh",
          "holds": [
            "hero.landing-hero",
            "below-fold",
            "shell.youtube-overlay"
          ]
        },
        {
          "id": "below-fold",
          "kind": "motion-wrapper",
          "holds": [
            "showcase.persona-tabs",
            "features.feature-grid",
            "support.faq",
            "cta.download-icon",
            "shell.footer"
          ],
          "motion": "{motion.recipe.entrance.below-fold}",
          "layout": "block, sections stack with their own top margins"
