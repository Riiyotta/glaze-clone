{
  "registryId": "primitive.image",
  "version": "1.1.0",
  "category": "media",
  "description": "Image, avatar and looping video frames. Every media field in a PageSpec must declare an assetRole from assets/asset-roles.json.",
  "props": {
    "kind": {
      "enum": [
        "video-loop",
        "feature-image",
        "avatar",
        "app-icon-image",
        "logo-svg",
        "cover-image",
        "prose-image",
        "jury-photo",
        "screenshot",
        "medal",
        "plan-mark"
      ]
    },
    "assetRole": {
      "type": "string",
      "description": "Must be a key in assets/asset-roles.json"
    },
    "alt": {
      "type": "string",
      "maxWords": 20
    },
    "aspect": {
      "type": "string"
    }
  },
  "variants": {
    "video-loop": {
      "radius": {
        "narrow": "{radius.card}",
        "wide": "{radius.media}"
      },
      "scrim": "{color.scrim.video}",
      "scrimHover": "{color.scrim.video-hover}",
      "playIconSize": "{foundation.iconSize.48}",
      "playIconOpacity": "{foundation.opacity.hover-accent}",
      "states": {
        "hover": {
          "scrim": "{color.scrim.video-hover}",
          "playIconScale": "{foundation.scale.hover-play}",
          "playIconOpacity": "{foundation.opacity.full}"
        },
        "transition": "{motion.recipe.hover.colors}",
        "iconTransition": {
          "duration": "{foundation.duration.150}",
          "easing": "{foundation.easing.standard}",
          "properties": [
            "all"
          ]
        }
      },
      "autoplay": "muted loop playsinline; see motion.recipe.video.autoplay",
      "cite": [
        "jsx.hero.video",
        "jsx.hero.scrim",
        "jsx.hero.play"
      ]
    },
    "feature-image": {
      "markup": "<picture> with a desktop source at min-width {foundation.breakpoint.800}, mobile image otherwise",
      "selectable": false,
      "cite": [
        "jsx.feature.picture"
      ]
    },
    "avatar": {
      "size": "{appCard.avatarSize}",
      "radius": "{radius.avatar}",
      "fit": "cover",
      "cite": [
        "jsx.appcard.author"
      ]
    },
    "app-icon-image": {
      "scale": "{foundation.scale.app-icon-image}",
      "fit": "cover",
      "note": "Always rendered through primitive.app-icon.",
      "cite": [
        "jsx.appicon.img"
      ]
    },
    "logo-svg": {
      "heightDesktop": "{navPill.logoHeight}",
      "heightMobile": "{mobilePanel.logoHeight}",
      "assetRole": "brand.wordmark",
      "cite": [
        "jsx.navpill.logo"
      ]
    },
    "cover-image": {
      "radius": {
        "card": "{radius.cover}",
        "article": "{radius.cover-large}"
      },
      "aspect": "1.9 / 1",
      "fit": "cover",
      "border": "{color.border.separator}",
      "hover": {
        "opacity": "{foundation.opacity.hover-accent}",
        "note": "Blog index only (group hover)."
      },
      "cite": [
        "jsx.blogindex.cover",
        "jsx.blogpost.cover"
      ]
    },
    "prose-image": {
      "radius": "{radius.prose-image}",
      "border": "{color.border.separator}",
      "cursor": "opens the lightbox on blog posts",
      "cite": [
        "jsx.prose.img"
      ]
    },
    "jury-photo": {
      "size": {
        "narrow": "{jury.photo}",
        "wide": "{jury.photoWide}"
      },
      "radius": "{radius.avatar}",
      "filter": "greyscale",
      "cite": [
        "jsx.jury.photo"
      ]
    },
    "screenshot": {
      "height": {
        "narrow": "{screenshotStrip.height}",
        "wide": "{screenshotStrip.heightWide}"
      },
      "radius": "{screenshotStrip.radius}",
      "snap": "x mandatory, start",
      "cite": [
        "jsx.shots.img",
        "jsx.shots.strip"
      ]
    },
    "medal": {
      "size": {
        "inline": "{foundation.iconSize.16}",
        "card": "{winnerCard.medal}",
        "prize": "{prize.icon}"
      },
      "cite": [
        "jsx.winners.card",
        "jsx.awardpill.root"
      ]
    },
    "plan-mark": {
      "size": "{foundation.iconSize.14}",
      "note": "Third-party mark in a plan row; blocked in generated mode.",
      "cite": [
        "jsx.pricing.feature"
      ]
    }
  },
  "tokens": [
    "radius.card",
    "radius.media",
    "color.scrim.video",
    "color.scrim.video-hover",
    "foundation.iconSize.48",
    "foundation.scale.hover-play",
    "foundation.scale.app-icon-image",
    "appCard.avatarSize",
    "radius.avatar",
    "navPill.logoHeight",
    "mobilePanel.logoHeight"
  ],
  "a11y": {
    "video": "The whole video card is role=button, tabIndex 0, opens the overlay on Enter or Space; context menu suppressed.",
    "decorative": "Hero play icon alt 'Play'; button-internal play icons alt ''."
  },
  "measuredFrom": [
    "jsx.hero.video",
    "jsx.feature.picture",
    "jsx.appcard.author"
  ]
}
