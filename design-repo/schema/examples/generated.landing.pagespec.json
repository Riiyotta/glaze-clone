    {
      "id": "faq-1",
      "type": "support.faq",
      "content": {
        "title": "FAQ",
        "items": [
          {
            "question": "What does the free plan include?",
            "answer": "Everything you need to write and organise notes for yourself, with a monthly allowance of assisted edits."
          },
          {
            "question": "How do plan credits renew?",
            "answer": "Credits refresh on the first day of every billing month and unused credits expire after sixty days."
          },
          {
            "question": "Can I cancel at any time?",
            "answer": "Yes. Cancel from the account page and your plan stays active until the end of the period."
          },
          {
            "question": "Where are my notes stored?",
            "answer": "Notes live in plain files on your Mac, so you can open them with any editor.",
            "link": {
              "label": "plans page",
              "href": "/pricing",
              "after": "."
            }
          }
        ]
      },
