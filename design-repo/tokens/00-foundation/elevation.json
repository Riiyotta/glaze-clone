{
  "$description": "Shadows, drop-shadow filters, backdrop blur and saturation (CLONE_SPEC 1.3; tailwind.config.js boxShadow/dropShadow; src/index.css component classes). Colours are references to foundation.color, never raw.",
  "foundation": {
    "shadow": {
      "dropdown-trigger": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "30px", "spread": "0px", "color": "{foundation.color.black-alpha.a18}" }, "$extensions": { "cite": ["tw.shadow"] } },
      "dropdown-menu": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "18px", "blur": "60px", "spread": "0px", "color": "{foundation.color.black-alpha.a45}" }, "$extensions": { "cite": ["tw.shadow"] } },
      "close-button": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "10px", "blur": "28px", "spread": "0px", "color": "{foundation.color.black-alpha.a28}" }, "$extensions": { "cite": ["tw.shadow"] } },
      "mobile-nav-open": { "$type": "shadow", "$value": [
        { "offsetX": "0px", "offsetY": "1px", "blur": "4px", "spread": "0px", "color": "{foundation.color.black-alpha.a12}" },
        { "offsetX": "0px", "offsetY": "26px", "blur": "48px", "spread": "0px", "color": "{foundation.color.black-alpha.a40}" },
        { "offsetX": "0px", "offsetY": "8px", "blur": "18px", "spread": "0px", "color": "{foundation.color.black-alpha.a20}" }
      ], "$extensions": { "cite": ["tw.shadow", "css.mobile-nav-open"] } },
      "focus-ring": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "2px", "color": "{foundation.color.white-alpha.a60}" }, "$description": "Global unlayered :focus-visible rule. It wins over every ring-* utility, so all focus rings on the built routes render at white/0.6 (pixel-audit correction).", "$extensions": { "cite": ["css.focus-ring"] } }
    },
    "dropShadow": {
      "glow": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "40px", "spread": "0px", "color": "{foundation.color.white-alpha.a12}" }, "$description": "filter: drop-shadow on the Glaze icon (.waitlist-icon-glow).", "$extensions": { "cite": ["css.icon-glow", "tw.dropshadow"] } },
      "particle": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px", "color": "{foundation.color.black-alpha.a40}" }, "$extensions": { "cite": ["css.icon-particle", "tw.dropshadow"] } }
    },
    "blur": {
      "menu-backdrop": { "$type": "dimension", "$value": "2.5px", "$extensions": { "cite": ["jsx.nav.backdrop"] } },
      "overlay": { "$type": "dimension", "$value": "4px", "$description": "backdrop-blur-sm on the YouTube overlay.", "$extensions": { "cite": ["jsx.overlay.backdrop"] } },
      "glass": { "$type": "dimension", "$value": "12px", "$extensions": { "cite": ["css.liquid-glass"] } },
      "glass-strong": { "$type": "dimension", "$value": "24px", "$description": "Open mobile nav panel and the persona popover (backdrop-blur-xl).", "$extensions": { "cite": ["css.mobile-nav-open", "jsx.dropdown.popup"] } }
    },
    "saturate": {
      "glass": { "$type": "number", "$value": 1.8, "$description": "saturate(180%).", "$extensions": { "cite": ["css.liquid-glass"] } },
      "glass-open": { "$type": "number", "$value": 1.5, "$description": "saturate(150%).", "$extensions": { "cite": ["css.mobile-nav-open"] } }
    },
    "gradient": {
      "nav-divider": { "$type": "gradient", "$value": { "kind": "linear", "angle": "90deg", "stops": [
        { "color": "{foundation.color.keyword.transparent}", "position": 0 },
        { "color": "{foundation.color.white-alpha.a14}", "position": 0.22 },
        { "color": "{foundation.color.white-alpha.a14}", "position": 0.78 },
        { "color": "{foundation.color.keyword.transparent}", "position": 1 }
      ] }, "$extensions": { "cite": ["jsx.nav.divider-gradient"] } },
      "app-icon-sheen": { "$type": "gradient", "$value": [
        { "kind": "radial", "shape": "35% 35% at 0 0", "stops": [
          { "color": "{foundation.color.white-alpha.a18}", "position": 0 },
          { "color": "{foundation.color.white-alpha.a04}", "position": 0.5 },
          { "color": "{foundation.color.keyword.transparent}", "position": 0.8 } ] },
        { "kind": "radial", "shape": "35% 35% at 100% 100%", "stops": [
          { "color": "{foundation.color.white-alpha.a10}", "position": 0 },
          { "color": "{foundation.color.white-alpha.a02}", "position": 0.5 },
          { "color": "{foundation.color.keyword.transparent}", "position": 0.8 } ] }
      ], "$description": "::before overlay of the app-icon squircle. #0000 stops are transparent.", "$extensions": { "cite": ["css.icon-sheen"] } }
    }
  }
}
