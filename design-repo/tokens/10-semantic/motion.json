{
  "$description": "Semantic motion recipes, composed from foundation.* motion tokens. Each recipe is one real, measured behaviour (CLONE_SPEC M1-M9, src/motion.js). `trigger` is when it runs; `reducedMotion` is what the generator must ship as the fallback.",
  "motion": {
    "recipe": {
      "hover.colors": { "$description": "Tailwind transition-colors: default for every link, button, tab, card.", "properties": ["color", "background-color", "border-color", "text-decoration-color", "fill", "stroke"], "duration": "{foundation.duration.150}", "easing": "{foundation.easing.standard}", "trigger": "hover (inside @media (hover: hover))", "cite": ["spec.motion.default"] },
      "hover.transform": { "$description": "transition-transform on arrows and chevrons.", "properties": ["transform"], "duration": "{foundation.duration.150}", "easing": "{foundation.easing.standard}", "trigger": "hover / data state", "cite": ["spec.motion.default"] },
      "entrance.hero-rise": { "$description": "M1. AnimateIn: fade-in-up, inline opacity 0, class animate-in. Five blocks, delays 0/100/200/300/400ms.", "keyframes": "{foundation.keyframes.fade-in-up}", "duration": "{foundation.duration.600}", "easing": "{foundation.easing.css-ease-out}", "fill": "both", "delays": ["{foundation.delay.0}", "{foundation.delay.100}", "{foundation.delay.200}", "{foundation.delay.300}", "{foundation.delay.400}"], "trigger": "page load (immediate, not scroll-gated)", "reducedMotion": "opacity 1, no transform, no animation", "cite": ["spec.motion.m1", "css.animate-in"] },
      "entrance.below-fold": { "$description": "M2. One fade-in on the wrapper around showcase..footer.", "keyframes": "{foundation.keyframes.fade-in}", "duration": "{foundation.duration.600}", "easing": "{foundation.easing.css-ease-out}", "delay": "{foundation.delay.500}", "fill": "both", "trigger": "page load", "reducedMotion": "opacity 1, no animation", "cite": ["spec.motion.m2", "jsx.app.belowfold"] },
      "entrance.panel": { "$description": "M3. Persona panel fades in on mount and on every tab change (React key = persona).", "keyframes": "{foundation.keyframes.fade-in}", "duration": "{foundation.duration.600}", "easing": "{foundation.easing.css-ease-out}", "fill": "both", "trigger": "tab change", "reducedMotion": "opacity 1, no animation", "cite": ["spec.motion.m3", "jsx.persona.panel"] },
      "entrance.nav-pill": { "$description": "Optional pill fade (nav-in). Not observed on direct loads.", "keyframes": "{foundation.keyframes.nav-in}", "duration": "{foundation.duration.1000}", "easing": "{foundation.easing.css-ease-out}", "fill": "both", "trigger": "first client render only", "optional": true, "reducedMotion": "opacity 1, no animation", "cite": ["spec.motion.m8", "css.animate-nav-in"] },
      "nav.dot-show": { "$description": "M8. Dot appears under the active link.", "properties": ["opacity", "transform"], "duration": "{foundation.duration.300}", "easing": "{foundation.easing.css-ease-out}", "from": "opacity 0, translateY 4px", "trigger": "active link set", "reducedMotion": "no transition", "cite": ["js.navdot.show"] },
      "nav.dot-hide": { "properties": ["opacity", "transform"], "duration": "{foundation.duration.200}", "easing": "{foundation.easing.css-ease-in}", "trigger": "active link cleared", "reducedMotion": "no transition", "cite": ["js.navdot.hide"] },
      "nav.dot-move": { "properties": ["left", "opacity", "transform"], "duration": "{foundation.duration.350}", "easing": "{foundation.easing.standard}", "trigger": "active link changes (left); opacity/transform use 300ms css-ease-out", "reducedMotion": "no transition", "cite": ["js.navdot.move"] },
      "nav.panel-height": { "$description": "Mobile panel opens by animating height: 52px closed, 50 + content + border open.", "properties": ["height"], "duration": "{foundation.duration.140}", "easing": "{foundation.easing.expo-out}", "trigger": "menu toggle", "reducedMotion": "no transition", "cite": ["css.mobile-nav-panel"] },
      "nav.panel-content": { "properties": ["opacity"], "duration": "{foundation.duration.100}", "easing": "{foundation.easing.tw-out}", "trigger": "menu toggle", "reducedMotion": "no transition", "note": "Source writes the Tailwind ease-out utility here.", "cite": ["jsx.mobilemenu.content"] },
      "nav.burger": { "properties": ["transform"], "duration": "{foundation.duration.150}", "easing": "{foundation.easing.tw-out}", "trigger": "menu toggle", "reducedMotion": "no transition", "cite": ["jsx.mobilemenu.burger"] },
      "nav.backdrop": { "properties": ["opacity"], "duration": "{foundation.duration.150}", "easing": "{foundation.easing.tw-out}", "trigger": "menu toggle", "reducedMotion": "no transition", "cite": ["jsx.nav.backdrop"] },
      "nav.link-handoff": { "$description": "After a mobile link click: close the menu, wait, then navigate.", "delay": "{foundation.delay.150}", "trigger": "mobile menu link click", "cite": ["jsx.mobilemenu.navdelay"] },
      "press.icon": { "$description": "Glaze icon: hover scale 1.05, active 0.95.", "properties": ["transform"], "duration": "{foundation.duration.300}", "easing": "{foundation.easing.tw-out}", "scaleHover": "{foundation.scale.hover}", "scaleActive": "{foundation.scale.press}", "trigger": "hover / active", "reducedMotion": "no transition", "cite": ["jsx.icon.scale"] },
      "faq.accordion": { "$description": "M9. grid-template-rows 0fr to 1fr; chevron rotates.", "properties": ["grid-template-rows", "transform"], "duration": "{foundation.duration.300}", "easing": "{foundation.easing.standard}", "rotate": "{foundation.rotate.quarter}", "trigger": "click; one item open at a time", "reducedMotion": "no transition", "note": "Source uses transition-all duration-300 ease-in-out (ease-in-out = standard).", "cite": ["spec.motion.m9", "jsx.faq.chevron"] },
      "faq.dim": { "$description": "M6. FAQ wrapper fades to 0.15 once scrolled past (visible = ratio >= 0.35 when above viewport top).", "properties": ["opacity"], "duration": "{foundation.duration.600}", "easing": "{foundation.easing.standard}", "dimmedOpacity": "{foundation.opacity.dimmed}", "thresholds": "{foundation.observer.faqDimThresholds}", "trigger": "IntersectionObserver", "reducedMotion": "keep opacity 1", "cite": ["spec.motion.m6", "js.faqdim"] },
      "chevron.rotate": { "properties": ["transform"], "duration": "{foundation.duration.150}", "easing": "{foundation.easing.standard}", "rotate": "{foundation.rotate.half}", "trigger": "dropdown open", "reducedMotion": "no transition", "cite": ["jsx.dropdown.chevron"] },
      "appicon.fade": { "$description": "App icon image/placeholder crossfade; placeholder uses animate-pulse.", "properties": ["opacity"], "duration": "{foundation.duration.200}", "easing": "{foundation.easing.standard}", "pulse": { "duration": "{foundation.duration.2000}", "easing": "{foundation.easing.pulse}" }, "trigger": "image load", "reducedMotion": "no pulse", "cite": ["jsx.appicon.fade", "jsx.appicon.pulse"] },
      "particles.burst": { "$description": "M7. JS rAF physics, no CSS keyframes.", "physics": "{foundation.particles}", "trigger": "click on Glaze icon", "reducedMotion": "do not spawn particles", "cite": ["spec.motion.m7", "js.particles.consts"] },
      "video.autoplay": { "$description": "M5. Below 624px a hook forces muted/playsInline and retries play().", "retries": "{foundation.observer.autoplayRetries}", "trigger": "viewport < 624px", "cite": ["spec.motion.m5", "js.autoplay.timers"] }
    }
  }
}
