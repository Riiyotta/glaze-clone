{
  "id": "section.content.release-entry",
  "typeId": "content.release-entry",
  "registryId": "section.content.release-entry",
  "version": "1.0.0",
  "category": "content",
  "semantic": {
    "id": "section.content.release-entry",
    "category": "content"
  },
  "source": {
    "id": "src.Changelog.article",
    "file": "src/pages/Changelog.jsx",
    "tag": "article",
    "domSelector": "main section article",
    "citation": "jsx.changelog.entry.source"
  },
  "retrievalEligible": true,
  "purpose": "One changelog release: version pill and date (sticky beside the entry from 1280), a linked release title, then prose blocks (h2 groups, paragraphs, bullet lists, images). Repeated newest first, separated by a hairline.",
  "scope": "Changelog.",
  "composes": [
    "component.release-aside",
    "component.prose-blocks",
    "primitive.badge",
    "primitive.text",
    "primitive.link",
    "primitive.divider"
  ],
  "contentModel": {
    "type": "object",
    "properties": {
      "version": {
        "type": "string",
        "maxWords": 1
      },
      "date": {
        "type": "string",
        "maxWords": 3
      },
      "datetime": {
        "type": "string",
        "pattern": "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$",
        "description": "ISO date, e.g. the datetime attribute"
      },
      "href": {
        "type": "string"
      },
      "title": {
        "type": "string",
        "maxWords": 12
      },
      "blocks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 40,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "h2"
                },
                "text": {
                  "type": "string",
                  "maxWords": 12
                }
              },
              "required": [
                "kind",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "p"
                },
                "text": {
                  "type": "string",
                  "maxWords": 60
                },
                "lead": {
                  "type": "string",
                  "maxWords": 8
                },
                "style": {
                  "enum": [
                    "body",
                    "quote"
                  ]
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxWords": 8
                      },
                      "href": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "text",
                      "href"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 4
                },
                "codes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxWords": 4
                  },
                  "minItems": 0,
                  "maxItems": 4
                }
              },
              "required": [
                "kind",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "ul"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "lead": {
                        "type": "string",
                        "maxWords": 8
                      },
                      "text": {
                        "type": "string",
                        "maxWords": 32
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 12
                }
              },
              "required": [
                "kind",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "img"
                },
                "image": {
                  "type": "object",
                  "properties": {
                    "assetRole": {
                      "enum": [
                        "article.image",
                        "media.user-supplied",
                        "media.generated"
                      ],
                      "referenceRoles": [
                        "article.image"
                      ],
                      "generatedRoles": [
                        "media.user-supplied",
                        "media.generated"
                      ]
                    },
                    "assetRef": {
                      "type": "string"
                    },
                    "alt": {
                      "type": "string",
                      "maxWords": 16
                    }
                  },
                  "required": [
                    "assetRole",
                    "assetRef"
                  ],
                  "additionalProperties": false
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "image",
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "required": [
      "version",
      "date",
      "datetime",
      "href",
      "title",
      "blocks"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedPatterns": [
      "none"
    ],
    "reducedMotionFallbackRequired": true,
    "reducedMotionFallbackEnum": [
      "none",
      "opacity-only",
      "static"
    ],
    "allowedFields": [
      "pattern",
      "delayMs",
      "reducedMotionFallback"
    ]
  },
  "responsive": [
    {
      "at": "{foundation.breakpoint.1280}",
      "change": "Three-column grid (1fr, 640, 1fr, gap 64); the version/date aside moves to the left column and sticks 116 below the top; vertical padding 40 to 64; list width 640 to 1240."
    }
  ],
  "constraints": {
    "repeatable": true,
    "maxPerPage": 60,
    "mustFollow": [
      "hero.page-header"
    ],
    "newestFirst": true
  },
  "containerRules": {
    "width": "{container.content} below 1280, {container.changelog-wide} from 1280",
    "column": "{container.changelog-column} from 1280",
    "gutter": "{space.page-gutter}",
    "paddingY": "{release.paddingY} below 1280, {release.paddingYWide} from 1280",
    "columnGap": "{release.columnGap}",
    "bodyGap": "{release.bodyGap}"
  },
  "measuredFrom": [
    "jsx.changelog.entry",
    "jsx.changelog.aside",
    "jsx.changelog.pill",
    "jsx.changelog.title",
    "jsx.changelog.wrap",
    "jsx.prose.root",
    "data.changelog.releases",
    "spec.blog.changelog"
  ]
}
