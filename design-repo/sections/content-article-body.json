{
  "id": "section.content.article-body",
  "typeId": "content.article-body",
  "registryId": "section.content.article-body",
  "version": "1.0.0",
  "category": "content",
  "semantic": {
    "id": "section.content.article-body",
    "category": "content"
  },
  "source": {
    "id": "src.Prose.div",
    "file": "src/components/blog/Prose.jsx",
    "tag": "div",
    "domSelector": ".markdown-content",
    "citation": "jsx.prose.source"
  },
  "retrievalEligible": true,
  "purpose": "Blog post prose: h2/h3 headings, paragraphs (bold lead-in, links, code, or a quote style), dash-bullet lists, dividers and clickable images that open the image gallery.",
  "scope": "Blog posts.",
  "composes": [
    "component.prose-blocks",
    "primitive.text",
    "primitive.link",
    "primitive.image",
    "primitive.divider"
  ],
  "contentModel": {
    "type": "object",
    "properties": {
      "blocks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 60,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "h2"
                },
                "text": {
                  "type": "string",
                  "maxWords": 14
                }
              },
              "required": [
                "kind",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "h3"
                },
                "text": {
                  "type": "string",
                  "maxWords": 12
                }
              },
              "required": [
                "kind",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "p"
                },
                "text": {
                  "type": "string",
                  "maxWords": 130
                },
                "lead": {
                  "type": "string",
                  "maxWords": 8
                },
                "style": {
                  "enum": [
                    "body",
                    "quote"
                  ]
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "maxWords": 8
                      },
                      "href": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "text",
                      "href"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 4
                },
                "codes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxWords": 4
                  },
                  "minItems": 0,
                  "maxItems": 4
                }
              },
              "required": [
                "kind",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "ul"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "lead": {
                        "type": "string",
                        "maxWords": 8
                      },
                      "text": {
                        "type": "string",
                        "maxWords": 32
                      }
                    },
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 12
                }
              },
              "required": [
                "kind",
                "items"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "hr"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "img"
                },
                "image": {
                  "type": "object",
                  "properties": {
                    "assetRole": {
                      "enum": [
                        "article.image",
                        "media.user-supplied",
                        "media.generated"
                      ],
                      "referenceRoles": [
                        "article.image"
                      ],
                      "generatedRoles": [
                        "media.user-supplied",
                        "media.generated"
                      ]
                    },
                    "assetRef": {
                      "type": "string"
                    },
                    "alt": {
                      "type": "string",
                      "maxWords": 16
                    }
                  },
                  "required": [
                    "assetRole",
                    "assetRef"
                  ],
                  "additionalProperties": false
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "image",
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "required": [
      "blocks"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedPatterns": [
      "none"
    ],
    "reducedMotionFallbackRequired": true,
    "reducedMotionFallbackEnum": [
      "none",
      "opacity-only",
      "static"
    ],
    "allowedFields": [
      "pattern",
      "delayMs",
      "reducedMotionFallback"
    ]
  },
  "responsive": [
    {
      "at": "{foundation.breakpoint.480}",
      "change": "Body 16/25 to 17/27."
    }
  ],
  "constraints": {
    "onePerPage": true,
    "mustFollow": [
      "content.article-header"
    ],
    "longForm": true,
    "maxImages": 12
  },
  "containerRules": {
    "width": "{container.content}",
    "gutter": "{space.page-gutter}",
    "marginTop": "{article.bodyGap}",
    "blockGap": "{article.paragraphGap}"
  },
  "measuredFrom": [
    "jsx.prose.root",
    "jsx.prose.h2",
    "jsx.prose.h3",
    "jsx.prose.img",
    "jsx.prose.link",
    "jsx.prose.code",
    "css.markdown-list",
    "data.blog.posts",
    "spec.blog.post"
  ]
}
