{
  "id": "section.support.faq",
  "typeId": "support.faq",
  "registryId": "section.support.faq",
  "version": "1.2.0",
  "category": "support",
  "semantic": {
    "id": "section.support.faq",
    "category": "support"
  },
  "source": {
    "id": "src.FAQ.div",
    "file": "src/components/FAQ.jsx",
    "tag": "div",
    "domSelector": "#faq",
    "citation": "jsx.faq.wrapper"
  },
  "retrievalEligible": true,
  "purpose": "Single-open accordion that dims once scrolled past.",
  "scope": "Landing, persona and pricing routes (the pricing page has a longer list).",
  "composes": [
    "component.faq-item"
  ],
  "contentModel": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxWords": 2
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "maxWords": 14
            },
            "answer": {
              "type": "string",
              "maxWords": 100
            },
            "link": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxWords": 4
                },
                "href": {
                  "type": "string"
                },
                "after": {
                  "type": "string",
                  "maxWords": 4
                }
              },
              "required": [
                "label",
                "href"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "question",
            "answer"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 12
      }
    },
    "required": [
      "title",
      "items"
    ],
    "additionalProperties": false
  },
  "motion": {
    "allowedPatterns": [
      "accordion-and-dim"
    ],
    "reducedMotionFallbackRequired": true,
    "reducedMotionFallbackEnum": [
      "none",
      "opacity-only",
      "static"
    ],
    "allowedFields": [
      "pattern",
      "delayMs",
      "reducedMotionFallback"
    ]
  },
  "responsive": [
    {
      "at": "{foundation.breakpoint.480}",
      "change": "Title 30 to 44; question 16 to 20; answer 14 to 16."
    }
  ],
  "constraints": {
    "onePerPage": true
  },
  "containerRules": {
    "width": "{container.content}",
    "gutter": "{space.page-gutter}",
    "marginTop": "{space.section-gap} below 480, {space.section-gap-wide} from 480",
    "scrollMargin": "{foundation.space.40}"
  },
  "measuredFrom": [
    "jsx.faq.root",
    "spec.faq"
  ]
}
